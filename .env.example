# Open WebUI Port (host port). Default is 3000; use 3002 if 3000/3001 are in use
OPEN_WEBUI_PORT=3000

# OpenUI Local Assets Port (host port for offline Nginx server)
OPENUI_ASSETS_PORT=8081

# Ollama Endpoint for Open WebUI container (connects to native host Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenUI Bundle version pinned for deterministic air-gapped hosting
OPENUI_BROWSER_BUNDLE_VERSION=0.1.4

# Open WebUI Session Encryption Key (generate using: openssl rand -hex 32)
WEBUI_SECRET_KEY=replace_with_openssl_rand_hex_32
